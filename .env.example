# Copy to .env and replace every placeholder. Never commit real values.
ARI_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost/release_intelligence
ARI_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key-separate-from-the-database
ARI_GITHUB_APP_ID=replace-with-github-app-id
ARI_GITHUB_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nreplace-with-github-app-private-key\n-----END PRIVATE KEY-----"
ARI_GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
ARI_GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
ARI_SESSION_TTL_SECONDS=28800
ARI_OAUTH_STATE_TTL_SECONDS=600

# Optional AI explanations remain disabled when ARI_OPENAI_API_KEY is unset.
# Token prices are required when enabled and must be current configured prices,
# expressed in USD per one million observed input/output tokens.
# ARI_OPENAI_API_KEY=replace-with-openai-api-key
# ARI_OPENAI_MODEL=gpt-5.6
# ARI_OPENAI_INPUT_COST_PER_MILLION=replace-with-current-input-price
# ARI_OPENAI_OUTPUT_COST_PER_MILLION=replace-with-current-output-price

# SECURITY: ingress and reverse-proxy access logs MUST omit query strings for
# /api/auth/github/callback. The application redacts its Uvicorn access log,
# but it cannot sanitize logs emitted upstream before a request reaches it.
