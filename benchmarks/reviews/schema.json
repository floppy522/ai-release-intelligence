{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://release-intelligence.invalid/benchmarks/reviews/schema.json",
  "title": "Release benchmark claim review",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "decisions"],
  "properties": {
    "version": {"type": "string", "pattern": "^[1-9][0-9]{0,2}\\.[0-9]{1,3}\\.[0-9]{1,3}$"},
    "decisions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "verdict", "reviewer", "rationale", "reviewed_at"],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,99}$"},
          "verdict": {"enum": ["supported", "unsupported"]},
          "reviewer": {"type": "string", "minLength": 1, "maxLength": 255},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
          "reviewed_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
